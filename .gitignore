# Игнорирование конфига bundler
/.bundle

# Игнорирование дефолтной базы данных SQLite.
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-shm
/db/*.sqlite3-wal

# Игнорирование всех логов и временных файлов.
/log/*.log
/tmp

# Игнорирование прочих ненужных файлов.

doc/
*.swp
*~
.project
.DS_Store
.idea
.secret
/public/uploads
coverage


# Local environment variables (secrets)
/.env

# Precompiled assets (built on deploy, never committed)
/public/assets
