.form-narrow
  %h2
    Edit
    = resource_name.to_s.humanize
  = image_tag "http://maps.google.com/maps/api/staticmap?size=450x300&sensor=false&zoom=16&markers=#{@user.latitude}%2C#{@user.longitude}", class: "img-fluid mb-3"
  = form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f|
    = render "devise/shared/error_messages", resource: resource
    .mb-3
      = f.label :email, class: "form-label"
      = f.email_field :email, autofocus: true, class: "form-control"
    - if devise_mapping.confirmable? && resource.pending_reconfirmation?
      %p
        Currently waiting confirmation for:
        = resource.unconfirmed_email
    .mb-3
      = f.label :password, class: "form-label"
      = f.password_field :password, autocomplete: "off", class: "form-control"
      .form-text Leave blank if you don't want to change it
    .mb-3
      = f.label :password_confirmation, class: "form-label"
      = f.password_field :password_confirmation, class: "form-control"
    .mb-3
      = f.label :current_password, class: "form-label"
      = f.password_field :current_password, class: "form-control"
      .form-text (we need your current password to confirm your changes)
    .mb-3
      = f.label :address, class: "form-label"
      = f.text_field :address, class: "form-control"
    .mb-3
      = f.label :city, class: "form-label"
      = f.text_field :city, class: "form-control"
    .mb-3
      = f.label :state, class: "form-label"
      = f.text_field :state, class: "form-control"
    .mb-3
      = f.label :country, class: "form-label"
      = f.text_field :country, class: "form-control"
    .mb-3
      = f.label :birthday, class: "form-label"
      = f.text_field :bday, class: "form-control"
    .mb-3
      = f.label :full_name, class: "form-label"
      = f.text_field :full_name, class: "form-control"
    .mb-3
      = f.label :zipcode, class: "form-label"
      = f.text_field :zip, class: "form-control"
    .mb-3
      = f.label :login, class: "form-label"
      = f.text_field :login, class: "form-control"
    = f.submit "Update", class: "btn btn-primary"

  %h3.mt-5 Cancel my account
  %p Unhappy?
  = button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?" }, method: :delete, class: "btn btn-outline-danger"
  .mt-3= link_to "Back", :back
