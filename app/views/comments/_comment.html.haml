- for comment in @advertisement.comment
  .card.mb-2{ class: "comment#{comment.id}" }
    .card-body.p-2
      .content= comment.content
      - if can?(:update, comment) || can?(:destroy, comment)
        .mt-2
          - if can? :update, comment
            = link_to "Edit", edit_comment_path(comment), class: "btn btn-sm btn-primary"
          - if can? :destroy, comment
            = link_to "Destroy", comment_path(comment), method: :delete, remote: true, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger"
