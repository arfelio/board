%h3 All users
.list-group.mb-3
  - @users.each do |user|
    .list-group-item.d-flex.justify-content-between.align-items-center
      %span= user.full_name
      %span
        - if can? :destroy, user
          = link_to "delete", user_path(user), method: :delete, class: "btn btn-sm btn-danger"
        - if can? :update, user
          = link_to "edit", edit_user_path(user), class: "btn btn-sm btn-outline-secondary"
        = link_to "show", user_path(user), class: "btn btn-sm btn-outline-secondary"
- if can? :create, @user
  = link_to "Create new user", new_user_path, class: "btn btn-primary mb-3"
= will_paginate @users
