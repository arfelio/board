.form-narrow
  %h3 Fill form to create new user
  = form_for(@user, html: { method: :post }) do |f|
    = render 'shared/error_messages', object: f.object
    .mb-3
      = f.label :email, class: "form-label"
      = f.email_field :email, class: "form-control"
    .mb-3
      = f.label :password, class: "form-label"
      = f.password_field :password, class: "form-control"
    .mb-3
      = f.label :password_confirmation, class: "form-label"
      = f.password_field :password_confirmation, class: "form-control"
    .mb-3
      = f.label :address, class: "form-label"
      = f.text_field :address, class: "form-control"
    .mb-3
      = f.label :city, class: "form-label"
      = f.text_field :city, class: "form-control"
    .mb-3
      = f.label :state, class: "form-label"
      = f.text_field :state, class: "form-control"
    .mb-3
      = f.label :country, class: "form-label"
      = f.text_field :country, class: "form-control"
    .mb-3
      = f.label :bday, class: "form-label"
      = f.text_field :bday, class: "form-control"
    .mb-3
      = f.label :full_name, class: "form-label"
      = f.text_field :full_name, class: "form-control"
    .mb-3
      = f.label :zip, class: "form-label"
      = f.text_field :zip, class: "form-control"
    .mb-3
      = f.label :login, class: "form-label"
      = f.text_field :login, class: "form-control"
    = hidden_field_tag "user[role_ids][]", nil
    .mb-3
      - Role.all.each do |r|
        .form-check
          = check_box_tag "user[role_ids][]", r.id, @user.role_ids.include?(r.id), id: dom_id(r), class: "form-check-input"
          = label_tag dom_id(r), r.name, class: "form-check-label"
    = f.submit "Create", class: "btn btn-primary"
