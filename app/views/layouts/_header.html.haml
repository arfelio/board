%nav.navbar.navbar-expand-lg.navbar-light.bg-light.border-bottom.mb-4
  .container-fluid
    = link_to "Board", advertisements_path, class: "navbar-brand"
    %button.navbar-toggler{type: "button", data: { "bs-toggle": "collapse", "bs-target": "#main-nav" }, aria: { controls: "main-nav", expanded: "false", label: "Toggle navigation" }}
      %span.navbar-toggler-icon
    #main-nav.collapse.navbar-collapse
      %ul.navbar-nav.me-auto
        %li.nav-item= link_to "Advertisements", advertisements_path, class: "nav-link"
        %li.nav-item= link_to "Users", users_path, class: "nav-link"
        - if can? :manage, Category
          %li.nav-item= link_to "Categories", categories_path, class: "nav-link"
      = form_tag(advertisements_path, method: "get", class: "d-flex my-2 my-lg-0 me-lg-3", role: "search") do
        = text_field_tag :query, params[:query], class: "form-control form-control-sm", placeholder: "Search", "aria-label": "Search"
      %ul.navbar-nav
        %li.nav-item.dropdown
          - if current_user
            = link_to "Profile", "#", class: "nav-link dropdown-toggle", role: "button", data: { "bs-toggle": "dropdown" }, aria: { expanded: "false" }
            %ul.dropdown-menu.dropdown-menu-end
              %li= button_to "Sign_out", destroy_user_session_path, method: :delete, class: "dropdown-item"
              %li= link_to "Edit profile", edit_user_registration_path, class: "dropdown-item"
              %li= link_to "View my profile", user_path(current_user), class: "dropdown-item"
          - else
            = link_to "Login", "#", class: "nav-link dropdown-toggle", role: "button", data: { "bs-toggle": "dropdown" }, aria: { expanded: "false" }
            %ul.dropdown-menu.dropdown-menu-end
              %li= link_to "Sign_in", new_user_session_path, class: "dropdown-item"
              %li= link_to "Sign_up", new_user_registration_path, class: "dropdown-item"
      - if current_user
        %span.navbar-text.ms-lg-3= current_user.login
