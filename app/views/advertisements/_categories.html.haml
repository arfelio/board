%h4 Categories
%ul.nav.nav-pills.flex-column.mb-4
  %li.nav-item= link_to "All", advertisements_path, class: ["nav-link", ("active" unless params[:category_id])]
  - @categories.each do |category|
    %li.nav-item= link_to category.title, advertisements_path(category_id: category.id), class: ["nav-link", ("active" if category.id.to_s == params[:category_id])]
