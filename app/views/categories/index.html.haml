%h1 Listing categories
= link_to 'New Category', new_category_path, class: "btn btn-primary mb-3"
%ul.list-group
  - @categories.each do |category|
    %li.list-group-item.d-flex.justify-content-between.align-items-center
      = category.title
      %span
        = link_to 'Show', category, class: "btn btn-sm btn-outline-secondary"
        = link_to 'Edit', edit_category_path(category), class: "btn btn-sm btn-outline-secondary"
        = delete_button "Destroy", category, confirm: "Are you sure?"
