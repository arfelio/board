# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Only needed in production; development and test generate their own key.
# Generate with: bin/rails secret
SECRET_KEY_BASE=

# Sent to Nominatim (OpenStreetMap's geocoder) with every address lookup. Its usage
# policy asks for a User-Agent that names your app and gives a way to reach you,
# for example "Board (you@example.com)". Optional: a generic name is used otherwise.
GEOCODER_USER_AGENT=
